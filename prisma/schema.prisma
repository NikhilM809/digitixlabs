generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum UserStatus {
  ACTIVE
  LEFT
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  WORK_FROM_HOME
}

enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_PENDING
  LEAVE_CANCELLED
  PAYSLIP_UPLOADED
  HOLIDAY_ANNOUNCEMENT
  BIRTHDAY
  WORK_ANNIVERSARY
  COMPANY_ANNOUNCEMENT
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
}

enum KraStatus {
  DRAFT
  EMPLOYEE_SUBMITTED
  UNDER_MANAGER_REVIEW
  MANAGER_REVIEWED
  COMPLETED
}

enum KraReviewCycle {
  MONTHLY
  QUARTERLY
}

enum EmployeeDocumentCategory {
  APPRAISAL
  LAPTOP_UNDERTAKING
  OFFER_LETTER
  APPOINTMENT_LETTER
  NDA
  ID_PROOF
  OTHER
}

model User {
  id                 String         @id @default(cuid())
  employeeId         String         @unique
  email              String         @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  avatar             String?
  role               RoleName       @default(EMPLOYEE)
  employmentType     EmploymentType @default(FULL_TIME)
  status             UserStatus     @default(ACTIVE)
  joiningDate        DateTime       @default(now())
  dateOfBirth        DateTime?
  emergencyContact   String?
  pan                String?
  aadhaarNumber      String?
  bankName           String?
  bankAccountNumber  String?
  ifscCode           String?
  baseSalary         Float          @default(0)
  hra                Float          @default(0)
  specialAllowance   Float          @default(0)
  internetAllowance  Float          @default(0)
  performanceBonus   Float          @default(0)
  ctc                Float          @default(0)
  incentive          Float          @default(0)
  reimbursement      Float          @default(0)
  profileCompletedAt DateTime?
  profileEditingEnabled Boolean     @default(false)
  departmentId       String?
  designationId      String?
  managerId          String?
  orgRoleId          String?
  administrativePositionId String?
  workStartTime      String?
  workEndTime        String?
  lateThreshold      Int?
  mustChangePassword Boolean        @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  department     Department?             @relation(fields: [departmentId], references: [id])
  designation    Designation?            @relation(fields: [designationId], references: [id])
  manager        User?                   @relation("ManagerTeam", fields: [managerId], references: [id])
  orgRole        EmployeeRoleDefinition? @relation(fields: [orgRoleId], references: [id], onDelete: SetNull)
  administrativePosition OrgAdministrativePosition? @relation(fields: [administrativePositionId], references: [id], onDelete: SetNull)
  teamMembers    User[]                  @relation("ManagerTeam")
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
  leaveBalances  LeaveBalance[]
  attendances    Attendance[]
  payslips       Payslip[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  loginHistory   LoginHistory[]
  accounts       Account[]
  sessions       Session[]
  workSchedules  WorkScheduleEntry[]
  kraReviews       KraReview[]        @relation("EmployeeKra")
  managedKras      KraReview[]        @relation("ManagerKra")
  employeeKras     EmployeeKra[]      @relation("EmployeeKraAssignments")
  kraConfigsCreated EmployeeKra[]     @relation("KraCreatedBy")
  kraConfigsUpdated EmployeeKra[]     @relation("KraUpdatedBy")
  kraConfig        EmployeeKraConfig?
  kraConfigsFinalized EmployeeKraConfig[] @relation("KraFinalizedBy")
  reportingHistory ReportingHistory[] @relation("ReportingHistoryUser")
  managedReportingHistory ReportingHistory[] @relation("ReportingHistoryManager")
  reportingChangesMade ReportingHistory[] @relation("ReportingHistoryChangedBy")
  employeeDocuments EmployeeDocument[] @relation("EmployeeDocuments")
  uploadedDocuments EmployeeDocument[] @relation("UploadedDocuments")
  dependents        EmployeeDependent[]
  topLevelCompanySettings CompanySettings[] @relation("CompanyTopLevelEmployee")

  // Worknest (Project Management)
  wnManagedProjects       WnProject[]              @relation("WnProjectManager")
  wnProjectAssignments    WnProjectAssignment[]      @relation("WnProjectAssignmentEmployee")
  wnAssignmentsCreated    WnProjectAssignment[]      @relation("WnProjectAssignmentAssigner")
  wnAssignedTasks         WnTask[]                   @relation("WnTaskAssignee")
  wnCreatedTasks          WnTask[]                   @relation("WnTaskAssigner")
  wnTimeEntries           WnTimeEntry[]              @relation("WnTimeEntryEmployee")
  wnReviewedHours         WnTimeEntry[]              @relation("WnHourReviewer")
  wnProjectNotes          WnProjectNote[]            @relation("WnProjectNoteAuthor")
  worknestNotifications   WorknestNotification[]     @relation("WorknestNotifications")
  wnProjectExports        WnProjectExport[]          @relation("WnProjectExporter")
  wnStatusChangedProjects WnProject[]                @relation("WnStatusChanger")
  wnProjectStatusChanges  WnProjectStatusChange[]    @relation("WnProjectStatusChanger")

  @@index([departmentId])
  @@index([managerId])
  @@index([orgRoleId])
  @@index([administrativePositionId])
  @@index([role])
  @@index([status])
}

model EmployeeRoleDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  accessLevel RoleName @default(EMPLOYEE)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees User[]

  @@index([isActive])
  @@index([accessLevel])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   User[]
}

model Designation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   User[]
}

model LeaveType {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String   @unique
  description        String?
  defaultDays        Int      @default(0)
  isPaid             Boolean  @default(true)
  requiresAttachment Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
}

model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  totalDays      Float    @default(0)
  usedDays       Float    @default(0)
  pendingDays    Float    @default(0)
  usedDaysManual Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id               String         @id @default(cuid())
  userId           String
  leaveTypeId      String
  fromDate         DateTime
  toDate           DateTime
  isHalfDay        Boolean        @default(false)
  halfDayPeriod    HalfDayPeriod?
  totalDays        Float
  reason           String
  attachment       String?
  emergencyContact String?
  status           LeaveStatus    @default(PENDING)
  managerComment   String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation("EmployeeLeaves", fields: [userId], references: [id], onDelete: Cascade)
  leaveType        LeaveType      @relation(fields: [leaveTypeId], references: [id])
  approvedBy       User?          @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  @@index([userId])
  @@index([status])
  @@index([fromDate, toDate])
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  workingHours  Float?
  overtimeHours Float?
  isLate        Boolean          @default(false)
  lateReason    String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([date])
}

model Payslip {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  salary            Float
  hra               Float    @default(0)
  specialAllowance  Float    @default(0)
  internetAllowance Float    @default(0)
  performanceBonus  Float    @default(0)
  bonus             Float    @default(0)
  incentive         Float    @default(0)
  reimbursement     Float    @default(0)
  deductions        Float    @default(0)
  netSalary  Float
  fileUrl    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month, year])
  @@index([month, year])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  details   String?     @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyName     String   @default("DigitixLabs")
  companyLogo     String?
  companyEmail    String?
  companyTan      String?
  leavePolicy     String?  @db.Text
  attendanceRules String?  @db.Text
  passwordPolicy  String?  @db.Text
  sessionTimeout  Int      @default(30)
  workStartTime   String   @default("09:00")
  workEndTime     String   @default("18:00")
  lateThreshold   Int      @default(15)
  timezone        String   @default("Asia/Kolkata")
  defaultEmployeeProfileEditingEnabled Boolean @default(false)
  orgHierarchyVisibleToEmployees Boolean @default(true)
  orgHierarchyVisibleToManagers  Boolean @default(true)
  dependentDetailsEnabled        Boolean @default(false)
  topLevelEmployeeId             String?
  orgChartLayoutJson             String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topLevelEmployee User? @relation("CompanyTopLevelEmployee", fields: [topLevelEmployeeId], references: [id], onDelete: SetNull)
}

model OrgAdministrativePosition {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees User[]
}

model CompanyPolicy {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkScheduleEntry {
  id            String    @id @default(cuid())
  userId        String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  workStartTime String
  workEndTime   String
  lateThreshold Int?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

model EmployeeKra {
  id          String   @id @default(cuid())
  userId      String
  name        String
  measure     String
  weight      Float?
  sortOrder   Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("EmployeeKraAssignments", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("KraCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("KraUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

model EmployeeKraConfig {
  userId        String         @id
  isFinalized   Boolean        @default(false)
  finalizedAt   DateTime?
  finalizedById String?
  reviewCycle   KraReviewCycle @default(MONTHLY)
  periodLabel   String?
  remarks       String?
  updatedAt     DateTime       @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalizedBy   User?     @relation("KraFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
}

model KraReview {
  id                  String    @id @default(cuid())
  userId              String
  managerId           String?
  month               Int
  year                Int
  status              KraStatus @default(DRAFT)
  employeeSubmittedAt DateTime?
  managerReviewedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation("EmployeeKra", fields: [userId], references: [id], onDelete: Cascade)
  manager             User?     @relation("ManagerKra", fields: [managerId], references: [id], onDelete: SetNull)
  items               KraItem[]

  @@unique([userId, month, year])
  @@index([managerId, status])
  @@index([userId, year, month])
}

model KraItem {
  id               String    @id @default(cuid())
  kraReviewId      String
  name             String
  measure          String?
  weight           Float     @default(0)
  description      String?
  achievement      String?
  employeeComments String?
  employeeRating   Float?
  managerRating    Float?
  employeePercentage Float?
  managerPercentage  Float?
  managerComments  String?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  kraReview        KraReview @relation(fields: [kraReviewId], references: [id], onDelete: Cascade)

  @@index([kraReviewId])
}

model ReportingHistory {
  id            String    @id @default(cuid())
  userId        String
  managerId     String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  changedById   String?
  createdAt     DateTime  @default(now())

  user      User  @relation("ReportingHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  manager   User? @relation("ReportingHistoryManager", fields: [managerId], references: [id], onDelete: SetNull)
  changedBy User? @relation("ReportingHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId, effectiveFrom])
  @@index([managerId])
}

model EmployeeDependent {
  id           String    @id @default(cuid())
  userId       String
  name         String
  relationship String
  dateOfBirth  DateTime?
  gender       String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeDocument {
  id           String                   @id @default(cuid())
  userId       String
  title        String
  category     EmployeeDocumentCategory @default(OTHER)
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  user       User @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([userId, isActive])
  @@index([category])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         RoleName
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([role, permissionId])
}

// ─── Worknest (Project Management) ─────────────────────────────────────────

enum WnProjectStatus {
  BID
  NEED_TO_START
  SCRIPT_WIP
  CHANGES
  LIVE
  HOLD
  CLOSE
  CANCEL
}

enum WnTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum WnInvoiceStatus {
  GENERATED
  PAID
}

enum WnBillingStage {
  NONE
  PENDING
  APPROVAL_REQUIRED
  APPROVED
}

enum WnHourStatus {
  SUBMITTED
  REVIEWED
}

model WnProject {
  id                    String          @id @default(cuid())
  code                  String          @unique
  name                  String
  clientName            String
  description           String          @default("")
  status                WnProjectStatus @default(BID)
  managerId             String
  manager               User            @relation("WnProjectManager", fields: [managerId], references: [id])
  sellValue             Float
  initialSellValue      Float           @default(0)
  programmerHours       Float           @default(0)
  qaHours               Float           @default(0)
  marginHours           Float           @default(0)
  initialEstimatedHours Float           @default(0)
  valueAlertSent        Boolean         @default(false)
  changesAlertSent      Boolean         @default(false)
  currencyId            String?
  currency              WnCurrency?     @relation(fields: [currencyId], references: [id])
  billingStage          WnBillingStage  @default(NONE)
  estimatedHours        Float
  startDate             DateTime?
  eta                   DateTime
  actualStartDate       DateTime?
  actualCompletionDate  DateTime?
  selfAssignEnabled     Boolean         @default(true)
  statusChangedAt       DateTime?
  statusChangedById     String?
  statusChangedBy       User?           @relation("WnStatusChanger", fields: [statusChangedById], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignments   WnProjectAssignment[]
  tasks         WnTask[]
  timeEntries   WnTimeEntry[]
  notes         WnProjectNote[]
  invoices      WnInvoice[]
  exports       WnProjectExport[]
  statusChanges WnProjectStatusChange[]

  @@index([status])
  @@index([managerId])
  @@index([clientName])
}

model WnProjectAssignment {
  id           String    @id @default(cuid())
  projectId    String
  project      WnProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     User      @relation("WnProjectAssignmentEmployee", fields: [employeeId], references: [id])
  assignedById String
  assignedBy   User      @relation("WnProjectAssignmentAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())

  @@unique([projectId, employeeId])
}

model WnTask {
  id                 String       @id @default(cuid())
  projectId          String
  project            WnProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  description        String       @default("")
  assignedEmployeeId String?
  assignedEmployee   User?        @relation("WnTaskAssignee", fields: [assignedEmployeeId], references: [id])
  assignedById       String?
  assignedBy         User?        @relation("WnTaskAssigner", fields: [assignedById], references: [id])
  assignedAt         DateTime?
  estimatedHours     Float        @default(0)
  startDate          DateTime?
  dueDate            DateTime?
  status             WnTaskStatus @default(NOT_STARTED)
  notes              String       @default("")
  selfAssignEnabled  Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  timeEntries WnTimeEntry[]
}

model WnTimeEntry {
  id           String       @id @default(cuid())
  projectId    String
  project      WnProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         WnTask?      @relation(fields: [taskId], references: [id])
  employeeId   String
  employee     User         @relation("WnTimeEntryEmployee", fields: [employeeId], references: [id])
  date         DateTime
  workType     String
  hours        Float
  notes        String       @default("")
  status       WnHourStatus @default(SUBMITTED)
  reviewedById String?
  reviewedBy   User?        @relation("WnHourReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId])
  @@index([employeeId])
  @@index([date])
}

model WnProjectNote {
  id        String    @id @default(cuid())
  projectId String
  project   WnProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("WnProjectNoteAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now())
}

model WnProjectStatusChange {
  id          String    @id @default(cuid())
  projectId   String
  project     WnProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedById String
  changedBy   User      @relation("WnProjectStatusChanger", fields: [changedById], references: [id])
  changedAt   DateTime  @default(now())

  @@index([projectId])
}

model WnInvoice {
  id             String          @id @default(cuid())
  invoiceNumber  String          @unique
  projectId      String
  project        WnProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          WnInvoiceBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  billingMonth   Int
  billingYear    Int
  invoiceDate    DateTime
  amount         Float
  currencyCode   String          @default("INR")
  currencySymbol String          @default("Rs.")
  status         WnInvoiceStatus @default(GENERATED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([projectId, billingMonth, billingYear])
}

model WnInvoiceBatch {
  id                  String          @id @default(cuid())
  invoiceNumber       String          @unique
  clientName          String
  billingMonth        Int
  billingYear         Int
  invoiceDate         DateTime
  currencyCode        String
  currencySymbol      String
  discount            Float           @default(0)
  gstRate             Float           @default(0)
  status              WnInvoiceStatus @default(GENERATED)
  source              String          @default("GENERATED")
  pdfPath             String          @default("")
  servicesDescription String          @default("")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  invoices            WnInvoice[]
}

model WnProjectExport {
  id           String    @id @default(cuid())
  projectId    String
  project      WnProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  exportedById String
  exportedBy   User      @relation("WnProjectExporter", fields: [exportedById], references: [id])
  exportedAt   DateTime  @default(now())
  billingMonth Int
  billingYear  Int
  exportType   String    @default("APPROVAL")
}

model WnClient {
  id        String   @id @default(cuid())
  name      String   @unique
  legalName String   @default("")
  address   String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WnInvoiceService {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WnWorkTypeOption {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String   @default("other")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model WnCurrency {
  id        String      @id @default(cuid())
  name      String
  code      String      @unique
  symbol    String
  active    Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  projects  WnProject[]
}

model WorknestNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("WorknestNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model WorknestSetting {
  id                  String @id @default("default")
  companyName         String @default("Digitix Labs")
  companyAddress      String @default("")
  companyEmail        String @default("")
  companyPhone        String @default("")
  logoUrl             String @default("")
  panNumber           String @default("")
  tanNumber           String @default("")
  gstin               String @default("")
  lutNumber           String @default("")
  servicesDescription String @default("Survey Programming and Consulting")
  gstRate             Float  @default(0)
  bankAccountName     String @default("")
  bankName            String @default("")
  bankAccountNumber   String @default("")
  bankIfsc            String @default("")
  bankSwift           String @default("")
  bankMicr            String @default("")
  bankBranch          String @default("")
  bankBranchCode      String @default("")
  bankCountry         String @default("India")
  billToName          String @default("")
  billToAddress       String @default("")
  currency            String @default("INR")
  etaWarningDays      Int    @default(7)
  invoicePrefix       String @default("PP/DXL")
}
