generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  WORK_FROM_HOME
}

enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_PENDING
  LEAVE_CANCELLED
  PAYSLIP_UPLOADED
  HOLIDAY_ANNOUNCEMENT
  BIRTHDAY
  WORK_ANNIVERSARY
  COMPANY_ANNOUNCEMENT
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
}

model User {
  id                 String         @id @default(cuid())
  employeeId         String         @unique
  email              String         @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  avatar             String?
  role               RoleName       @default(EMPLOYEE)
  employmentType     EmploymentType @default(FULL_TIME)
  status             UserStatus     @default(ACTIVE)
  joiningDate        DateTime       @default(now())
  dateOfBirth        DateTime?
  emergencyContact   String?
  departmentId       String?
  designationId      String?
  managerId          String?
  mustChangePassword Boolean        @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  department     Department?    @relation(fields: [departmentId], references: [id])
  designation    Designation?   @relation(fields: [designationId], references: [id])
  manager        User?          @relation("ManagerTeam", fields: [managerId], references: [id])
  teamMembers    User[]         @relation("ManagerTeam")
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
  leaveBalances  LeaveBalance[]
  attendances    Attendance[]
  payslips       Payslip[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  loginHistory   LoginHistory[]
  accounts       Account[]
  sessions       Session[]

  @@index([departmentId])
  @@index([managerId])
  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   User[]
}

model Designation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   User[]
}

model LeaveType {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String   @unique
  description        String?
  defaultDays        Int      @default(0)
  isPaid             Boolean  @default(true)
  requiresAttachment Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
}

model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  totalDays   Float    @default(0)
  usedDays    Float    @default(0)
  pendingDays Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id               String         @id @default(cuid())
  userId           String
  leaveTypeId      String
  fromDate         DateTime
  toDate           DateTime
  isHalfDay        Boolean        @default(false)
  halfDayPeriod    HalfDayPeriod?
  totalDays        Float
  reason           String
  attachment       String?
  emergencyContact String?
  status           LeaveStatus    @default(PENDING)
  managerComment   String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation("EmployeeLeaves", fields: [userId], references: [id], onDelete: Cascade)
  leaveType        LeaveType      @relation(fields: [leaveTypeId], references: [id])
  approvedBy       User?          @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  @@index([userId])
  @@index([status])
  @@index([fromDate, toDate])
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  workingHours  Float?
  overtimeHours Float?
  isLate        Boolean          @default(false)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([date])
}

model Payslip {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  salary     Float
  bonus      Float    @default(0)
  deductions Float    @default(0)
  netSalary  Float
  fileUrl    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month, year])
  @@index([month, year])
}

model HolidayCalendar {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  description String?
  isRegional  Boolean  @default(false)
  region      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  details   String?     @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyName     String   @default("Digitix Labs")
  companyLogo     String?
  companyEmail    String?
  leavePolicy     String?  @db.Text
  attendanceRules String?  @db.Text
  passwordPolicy  String?  @db.Text
  sessionTimeout  Int      @default(30)
  workStartTime   String   @default("09:00")
  workEndTime     String   @default("18:00")
  lateThreshold   Int      @default(15)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         RoleName
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([role, permissionId])
}
