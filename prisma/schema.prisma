generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum UserStatus {
  ACTIVE
  LEFT
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  WORK_FROM_HOME
}

enum NotificationType {
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_PENDING
  LEAVE_CANCELLED
  PAYSLIP_UPLOADED
  HOLIDAY_ANNOUNCEMENT
  BIRTHDAY
  WORK_ANNIVERSARY
  COMPANY_ANNOUNCEMENT
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
}

enum CustomRoleStatus {
  ACTIVE
  INACTIVE
}

enum RoleAuditAction {
  CREATE
  UPDATE
  DELETE
  DUPLICATE
  ACTIVATE
  DEACTIVATE
  PERMISSION_CHANGE
  ASSIGN
  REMOVE
}

enum KraStatus {
  DRAFT
  EMPLOYEE_SUBMITTED
  UNDER_MANAGER_REVIEW
  MANAGER_REVIEWED
  COMPLETED
}

enum KraReviewCycle {
  MONTHLY
  QUARTERLY
}

enum EmployeeDocumentCategory {
  APPRAISAL
  LAPTOP_UNDERTAKING
  OFFER_LETTER
  APPOINTMENT_LETTER
  NDA
  ID_PROOF
  OTHER
}

model User {
  id                 String         @id @default(cuid())
  employeeId         String         @unique
  email              String         @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  avatar             String?
  role               RoleName       @default(EMPLOYEE)
  employmentType     EmploymentType @default(FULL_TIME)
  status             UserStatus     @default(ACTIVE)
  joiningDate        DateTime       @default(now())
  dateOfBirth        DateTime?
  emergencyContact   String?
  pan                String?
  aadhaarNumber      String?
  bankAccountNumber  String?
  baseSalary         Float          @default(0)
  ctc                Float          @default(0)
  incentive          Float          @default(0)
  reimbursement      Float          @default(0)
  departmentId       String?
  designationId      String?
  managerId          String?
  workStartTime      String?
  workEndTime        String?
  lateThreshold      Int?
  mustChangePassword Boolean        @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  department     Department?    @relation(fields: [departmentId], references: [id])
  designation    Designation?   @relation(fields: [designationId], references: [id])
  manager        User?          @relation("ManagerTeam", fields: [managerId], references: [id])
  teamMembers    User[]         @relation("ManagerTeam")
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
  leaveBalances  LeaveBalance[]
  attendances    Attendance[]
  payslips       Payslip[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  loginHistory   LoginHistory[]
  accounts       Account[]
  sessions       Session[]
  workSchedules  WorkScheduleEntry[]
  kraReviews       KraReview[]        @relation("EmployeeKra")
  managedKras      KraReview[]        @relation("ManagerKra")
  employeeKras     EmployeeKra[]      @relation("EmployeeKraAssignments")
  kraConfigsCreated EmployeeKra[]     @relation("KraCreatedBy")
  kraConfigsUpdated EmployeeKra[]     @relation("KraUpdatedBy")
  kraConfig        EmployeeKraConfig?
  kraConfigsFinalized EmployeeKraConfig[] @relation("KraFinalizedBy")
  reportingHistory ReportingHistory[] @relation("ReportingHistoryUser")
  managedReportingHistory ReportingHistory[] @relation("ReportingHistoryManager")
  reportingChangesMade ReportingHistory[] @relation("ReportingHistoryChangedBy")
  employeeDocuments EmployeeDocument[] @relation("EmployeeDocuments")
  uploadedDocuments EmployeeDocument[] @relation("UploadedDocuments")
  dependents        EmployeeDependent[]
  customRoles       UserCustomRole[]
  roleAssignments   UserCustomRole[]   @relation("RoleAssignments")
  managedCustomRoles CustomRole[]      @relation("CustomRoleManager")

  @@index([departmentId])
  @@index([managerId])
  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   User[]
  customRoles CustomRole[]
}

model Designation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employees   User[]
}

model LeaveType {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String   @unique
  description        String?
  defaultDays        Int      @default(0)
  isPaid             Boolean  @default(true)
  requiresAttachment Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
}

model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  totalDays      Float    @default(0)
  usedDays       Float    @default(0)
  pendingDays    Float    @default(0)
  usedDaysManual Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  @@unique([userId, leaveTypeId, year])
}

model LeaveRequest {
  id               String         @id @default(cuid())
  userId           String
  leaveTypeId      String
  fromDate         DateTime
  toDate           DateTime
  isHalfDay        Boolean        @default(false)
  halfDayPeriod    HalfDayPeriod?
  totalDays        Float
  reason           String
  attachment       String?
  emergencyContact String?
  status           LeaveStatus    @default(PENDING)
  managerComment   String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation("EmployeeLeaves", fields: [userId], references: [id], onDelete: Cascade)
  leaveType        LeaveType      @relation(fields: [leaveTypeId], references: [id])
  approvedBy       User?          @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  @@index([userId])
  @@index([status])
  @@index([fromDate, toDate])
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus @default(PRESENT)
  workingHours  Float?
  overtimeHours Float?
  isLate        Boolean          @default(false)
  lateReason    String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([date])
}

model Payslip {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  salary         Float
  bonus          Float    @default(0)
  incentive      Float    @default(0)
  reimbursement  Float    @default(0)
  deductions     Float    @default(0)
  netSalary  Float
  fileUrl    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month, year])
  @@index([month, year])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  details   String?     @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyName     String   @default("Digitix Labs")
  companyLogo     String?
  companyEmail    String?
  companyTan      String?
  leavePolicy     String?  @db.Text
  attendanceRules String?  @db.Text
  passwordPolicy  String?  @db.Text
  sessionTimeout  Int      @default(30)
  workStartTime   String   @default("09:00")
  workEndTime     String   @default("18:00")
  lateThreshold   Int      @default(15)
  orgHierarchyVisibleToEmployees Boolean @default(true)
  orgHierarchyVisibleToManagers  Boolean @default(true)
  dependentDetailsEnabled        Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompanyPolicy {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkScheduleEntry {
  id            String    @id @default(cuid())
  userId        String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  workStartTime String
  workEndTime   String
  lateThreshold Int?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

model EmployeeKra {
  id          String   @id @default(cuid())
  userId      String
  name        String
  measure     String
  weight      Float?
  sortOrder   Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("EmployeeKraAssignments", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("KraCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("KraUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

model EmployeeKraConfig {
  userId        String         @id
  isFinalized   Boolean        @default(false)
  finalizedAt   DateTime?
  finalizedById String?
  reviewCycle   KraReviewCycle @default(MONTHLY)
  periodLabel   String?
  remarks       String?
  updatedAt     DateTime       @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalizedBy   User?     @relation("KraFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
}

model KraReview {
  id                  String    @id @default(cuid())
  userId              String
  managerId           String?
  month               Int
  year                Int
  status              KraStatus @default(DRAFT)
  employeeSubmittedAt DateTime?
  managerReviewedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation("EmployeeKra", fields: [userId], references: [id], onDelete: Cascade)
  manager             User?     @relation("ManagerKra", fields: [managerId], references: [id], onDelete: SetNull)
  items               KraItem[]

  @@unique([userId, month, year])
  @@index([managerId, status])
  @@index([userId, year, month])
}

model KraItem {
  id               String    @id @default(cuid())
  kraReviewId      String
  name             String
  measure          String?
  weight           Float     @default(0)
  description      String?
  achievement      String?
  employeeComments String?
  employeeRating   Float?
  managerRating    Float?
  employeePercentage Float?
  managerPercentage  Float?
  managerComments  String?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  kraReview        KraReview @relation(fields: [kraReviewId], references: [id], onDelete: Cascade)

  @@index([kraReviewId])
}

model ReportingHistory {
  id            String    @id @default(cuid())
  userId        String
  managerId     String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  changedById   String?
  createdAt     DateTime  @default(now())

  user      User  @relation("ReportingHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  manager   User? @relation("ReportingHistoryManager", fields: [managerId], references: [id], onDelete: SetNull)
  changedBy User? @relation("ReportingHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId, effectiveFrom])
  @@index([managerId])
}

model EmployeeDependent {
  id           String    @id @default(cuid())
  userId       String
  name         String
  relationship String
  dateOfBirth  DateTime?
  gender       String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeDocument {
  id           String                   @id @default(cuid())
  userId       String
  title        String
  category     EmployeeDocumentCategory @default(OTHER)
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  user       User @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([userId, isActive])
  @@index([category])
}

model Permission {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  description           String?
  module                String
  action                String?
  createdAt             DateTime               @default(now())
  rolePermissions       RolePermission[]
  customRolePermissions CustomRolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         RoleName
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([role, permissionId])
}

model CustomRole {
  id             String             @id @default(cuid())
  name           String             @unique
  code           String             @unique
  description    String?
  departmentId   String?
  managerId      String?
  status         CustomRoleStatus   @default(ACTIVE)
  isSystem       Boolean            @default(false)
  systemRoleKey  RoleName?
  hierarchyLevel Int                @default(0)
  parentRoleId   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  department   Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager      User?                  @relation("CustomRoleManager", fields: [managerId], references: [id], onDelete: SetNull)
  parentRole   CustomRole?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles   CustomRole[]           @relation("RoleHierarchy")
  permissions  CustomRolePermission[]
  userRoles    UserCustomRole[]
  auditLogs    RoleAuditLog[]

  @@index([status])
  @@index([departmentId])
  @@index([parentRoleId])
  @@index([isSystem])
}

model CustomRolePermission {
  id           String     @id @default(cuid())
  customRoleId String
  permissionId String
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([customRoleId, permissionId])
  @@index([permissionId])
}

model UserCustomRole {
  id            String    @id @default(cuid())
  userId        String
  customRoleId  String
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  assignedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation("RoleAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customRoleId])
  @@index([effectiveFrom, effectiveTo])
}

model RoleAuditLog {
  id           String          @id @default(cuid())
  actorId      String?
  action       RoleAuditAction
  customRoleId String?
  userId       String?
  details      String?         @db.Text
  createdAt    DateTime        @default(now())

  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@index([customRoleId])
  @@index([userId])
  @@index([createdAt])
}
