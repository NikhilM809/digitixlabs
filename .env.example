# Database
DATABASE_URL="postgresql://hrms:hrms_password@localhost:5432/digitix_hrms?schema=public"

# NextAuth v5 (Auth.js) - AUTH_SECRET is required
AUTH_SECRET="digitix-hrms-secret-key-change-in-production-2026"
AUTH_URL="http://localhost:3000"

# Legacy names (also supported)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="digitix-hrms-secret-key-change-in-production-2026"

# JWT
JWT_SECRET="digitix-jwt-secret-key-change-in-production-2026"

# UploadThing (optional - for document uploads)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# App
NEXT_PUBLIC_APP_NAME="Digitix HRMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
