# Database
DATABASE_URL="postgresql://hrms:hrms_password@localhost:5432/digitix_hrms?schema=public"

# Apply migrations without shadow DB (use on Windows when migrate dev fails with P3014):
#   npm run db:migrate:deploy
# Or grant CREATEDB to your DB user (see scripts/fix-postgres-permissions.sql) for: npm run db:migrate

# NextAuth v5 (Auth.js) - AUTH_SECRET is required
AUTH_SECRET="digitix-hrms-secret-key-change-in-production-2026"
AUTH_URL="http://localhost:3000"

# Legacy names (also supported)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="digitix-hrms-secret-key-change-in-production-2026"

# JWT
JWT_SECRET="digitix-jwt-secret-key-change-in-production-2026"

# UploadThing (optional - for document uploads)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# App
NEXT_PUBLIC_APP_NAME="Digitix HRMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP) — required in production for password reset emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Digitix HRMS <noreply@digitixlabs.com>"
